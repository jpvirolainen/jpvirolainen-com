        <text x="38" y="58" fill="#67A4FF" font-family="Geist Mono, monospace" font-size="10.5">NEURAL LAYER</text>
        <text x="38" y="86" fill="#F1F6FF" font-family="Geist, sans-serif" font-size="15" font-weight="600">Pattern Recognition</text>
        <text x="38" y="112" fill="#98B2D4" font-family="Geist, sans-serif" font-size="12.5">Detects behavioral patterns in</text>
        <text x="38" y="130" fill="#98B2D4" font-family="Geist, sans-serif" font-size="12.5">real time across messy signals.</text>
        <text x="38" y="168" fill="#6780A3" font-family="Geist Mono, monospace" font-size="10">REACTIVE · STATISTICAL</text>

        <line x1="255" y1="115" x2="298" y2="115" stroke="#00E5FF" stroke-width="1.8" />
        <polygon points="298,110 308,115 298,120" fill="#00E5FF" />

        <rect x="312" y="32" width="235" height="166" fill="#0A1F3D" stroke="#00E5FF" stroke-width="1.2" />
        <text x="330" y="58" fill="#00E5FF" font-family="Geist Mono, monospace" font-size="10.5">SYMBOLIC LAYER</text>
