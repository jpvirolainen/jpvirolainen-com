        <text x="330" y="168" fill="#00E5FF" font-family="Geist Mono, monospace" font-size="10">PROACTIVE · EXPLAINABLE</text>

        <line x1="547" y1="115" x2="590" y2="115" stroke="#00E5FF" stroke-width="1.8" />
        <polygon points="590,110 600,115 590,120" fill="#00E5FF" />

        <rect x="604" y="32" width="176" height="166" fill="#0D2140" stroke="#284A80" stroke-width="1.2" />
        <text x="620" y="58" fill="#00E5FF" font-family="Geist Mono, monospace" font-size="10.5">OUTCOME</text>
        <text x="620" y="86" fill="#FFFFFF" font-family="Geist, sans-serif" font-size="14.5" font-weight="600">Coherent Action</text>
        <text x="620" y="112" fill="#98B2D4" font-family="Geist, sans-serif" font-size="12.5">Right nudge at the</text>
        <text x="620" y="130" fill="#98B2D4" font-family="Geist, sans-serif" font-size="12.5">right stage, with an</text>
        <text x="620" y="148" fill="#98B2D4" font-family="Geist, sans-serif" font-size="12.5">auditable reason.</text>
      </svg>
    </div>
    <figcaption class="diagram-caption">Figure: Pairing neural pattern recognition with symbolic state logic produces proactive, explainable systems.</figcaption>
  </figure>
)}

<script is:inline>
  document.querySelectorAll('[data-wave-widget]').forEach((widget) => {
    const buttons = widget.querySelectorAll('[data-wave-btn]');
    const detail = widget.querySelector('[data-wave-detail]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        if (detail) {
          detail.textContent = btn.getAttribute('data-detail') || '';
        }
      });
    });
  });
</script>
